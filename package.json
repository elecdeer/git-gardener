{
  "name": "git-gardener",
  "version": "0.3.1",
  "description": "A CLI tool for managing and pruning git branches",
  "bin": {
    "git-gardener": "./build/index"
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "build:release": "tsdown --config tsdown.release.config.ts",
    "dev": "tsx src/index.ts",
    "start": "./build/index",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@gunshi/plugin-completion": "^0.29.5",
    "gunshi": "^0.29.5",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@tsdown/exe": "^0.21.10",
    "@types/node": "^25.6.0",
    "@typescript/native-preview": "latest",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "oxlint-tsgolint": "^0.22.1",
    "tsdown": "^0.21.10",
    "tsx": "^4.0.0",
    "vitest": "^4.1.5"
  },
  "devEngines": {
    "node": ">=26",
    "pnpm": ">=11"
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.0.8"
}
