{
  "name": "git-gardener",
  "version": "0.1.0",
  "description": "A CLI tool for managing and pruning git branches",
  "bin": {
    "git-gardener": "./build/index"
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/index.ts",
    "start": "./build/index",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "gunshi": "^0.29.5"
  },
  "devDependencies": {
    "@tsdown/exe": "^0.21.10",
    "@types/node": "^25.6.0",
    "@typescript/native-preview": "latest",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "oxlint-tsgolint": "^0.22.1",
    "tsdown": "^0.21.10",
    "tsx": "^4.0.0",
    "vitest": "^4.1.5"
  },
  "devEngines": {
    "node": ">=26",
    "pnpm": ">=11"
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.0.8"
}
