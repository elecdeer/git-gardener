{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/crates/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "ignorePatterns": ["dist/", "node_modules/"]
}
